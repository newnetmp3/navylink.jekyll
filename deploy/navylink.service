[Unit]
Description=Navylink FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=navylink
Group=navylink
WorkingDirectory=/opt/navylink
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/navylink/.venv/bin/uvicorn server.app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/navylink

[Install]
WantedBy=multi-user.target
